# ── Tournament feature (Supabase) ───────────────────────────────────────────
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# If these are unset, the /tournaments page degrades gracefully (503) and the
# rest of the site is unaffected. See docs/tournaments.md for full setup.

# Dedicated tournament Supabase project (separate from any other Supabase
# project the repo uses). All access is server-side via the secret key, so the
# URL does not need a NEXT_PUBLIC_ prefix.
TOURNAMENT_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SECRET — server-only. Never expose to the browser. (sb_secret_... or service_role)
TOURNAMENT_SUPABASE_SECRET_KEY=

# Protects /api/cron/tournament-sweep. Vercel Cron sends this as a Bearer token.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Admin secret for /tournaments/admin and /api/tournaments/admin (you only).
# Generate: openssl rand -hex 32
TOURNAMENT_ADMIN_SECRET=

# ── Paid tournaments (Base USDC escrow) ──────────────────────────────────────
# Optional. When unset, paid tournaments are simply disabled (free events and
# the rest of the site are unaffected). See docs/paid-tournaments-escrow.md and
# contracts/. Set these after deploying the escrow (Base Sepolia first).
#
# Deployed escrow proxy address (from `make deploy-sepolia` / `deploy-base`).
TOURNAMENT_ESCROW_ADDRESS=
# 84532 = Base Sepolia (test), 8453 = Base mainnet.
TOURNAMENT_ESCROW_CHAIN_ID=84532
# Base RPC endpoint (Alchemy/Infura/QuickNode or public).
TOURNAMENT_ESCROW_RPC_URL=https://sepolia.base.org
# Blocks to wait before a deposit seats a player (reorg safety). Default 10.
TOURNAMENT_ESCROW_MIN_CONFIRMATIONS=10
