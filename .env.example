# ── Tournament feature (Supabase) ───────────────────────────────────────────
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# If these are unset, the /tournaments page degrades gracefully (503) and the
# rest of the site is unaffected. See docs/tournaments.md for full setup.

# Dedicated tournament Supabase project (separate from any other Supabase
# project the repo uses). All access is server-side via the secret key, so the
# URL does not need a NEXT_PUBLIC_ prefix.
TOURNAMENT_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SECRET — server-only. Never expose to the browser. (sb_secret_... or service_role)
TOURNAMENT_SUPABASE_SECRET_KEY=

# Protects /api/cron/tournament-sweep. Vercel Cron sends this as a Bearer token.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
