# Optional env vars preserved for future data / integrations (not used by the app UI today).
# Copy keys you need into `.env.local` (never commit real secrets).

# --- Supabase (if you wire backend tables later) ---
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# --- Wallet auth (SIWE + JWT sessions) ---
# WALLET_SESSION_SECRET=          # Required for wallet sign-in. Min 32 chars.
#                                  # Generate: openssl rand -base64 32
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=  # Optional. Register free at cloud.walletconnect.com
#                                         # Without it, injected + Coinbase wallets still work.

# --- eBay Browse API (client credentials) ---
# EBAY_APP_ID=
# EBAY_CERT_ID=
# EBAY_MARKETPLACE=EBAY_US

# --- Notifications ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=
