# Copy to .env and fill in. NEVER commit the real .env.
# Used by script/Deploy.s.sol and the RPC/etherscan config in foundry.toml.

# Deployer key that broadcasts the deploy txs (needs Base ETH for gas).
# Prefer a dedicated deployer, not a key that will custody funds.
PRIVATE_KEY=0x

# Upgrade / pause authority. Keep this COLD - a Safe multisig in production.
OWNER=0x

# Hot automation key the backend uses to run autopilot (create/lock/settle).
# Optional: defaults to OWNER when unset. Set it to keep OWNER cold. The deploy
# script can only wire it automatically when the deployer == OWNER; otherwise
# OWNER calls setOperator(OPERATOR) afterwards.
OPERATOR=0x

# Rake recipient - where the 15% goes (can equal OWNER for v1).
PLATFORM=0x

# OPTIONAL winner-approval authority address (used by script/Upgrade.s.sol). When
# set, the owner also calls setApprover(APPROVER) during the upgrade so the
# winner allowlist is gated to this SEPARATE key. It MUST differ from OPERATOR:
# the mitigation only holds if the key that settles games cannot also approve
# winners. Leave unset to keep approver == address(0) (falls back to OWNER as the
# effective approver). This is an ADDRESS here (the script only needs the address);
# the backend signs approvals with the matching private key in
# TOURNAMENT_ESCROW_APPROVER_KEY (see the app .env).
APPROVER=

# Settlement token for the target chain.
#   Base mainnet  0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   Base Sepolia  0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# RPC endpoints (Alchemy/Infura/QuickNode or public).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# For contract source verification on Basescan.
BASESCAN_API_KEY=
