# Dependencies
node_modules/

# Next.js
.next/
out/

# Raw scraped data (not needed for build; regenerable)
data/
# But DO track upload markers - they tell CI what's already on R2
# so cold-cache runs don't re-upload 20K images (which exceeds the
# 90-min Action timeout).
!data/uploaded-*.json

# Downloaded images (upload to R2, don't commit)
public/cards/
public/cards-*/

# Full BONK brand kit archive - kept local only (the app uses the
# optimized subset committed under public/bonk/). See public/bonk/BRAND.md.
brand-kit/

# Secrets - NEVER commit these
.env
.env.local
.env*.local
wrangler.toml

# Misc
.DS_Store
*.log

# Exploratory market-API probe outputs (raw JSON snapshots, regenerable)
scripts/market/probe-out/

# TS incremental build
tsconfig.tsbuildinfo
.vercel

# Preview role-play bot tokens (throwaway, preview-only)
.preview-bot-tokens.json
